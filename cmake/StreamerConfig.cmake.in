@PACKAGE_INIT@

# Prepend third-party install prefixes so find_dependency can locate them
# (when Streamer was built with BUILD_THIRDPARTY)
include("${CMAKE_CURRENT_LIST_DIR}/StreamerConfigPaths.cmake" OPTIONAL)
if(Streamer_THIRDPARTY_CMAKE_PREFIX_PATH)
  list(PREPEND CMAKE_PREFIX_PATH ${Streamer_THIRDPARTY_CMAKE_PREFIX_PATH})
endif()
if(Streamer_GSTREAMER_PKG_CONFIG_PATH)
  if(DEFINED CMAKE_ENV_PKG_CONFIG_PATH_SEPARATOR)
    set(ENV{PKG_CONFIG_PATH} "${Streamer_GSTREAMER_PKG_CONFIG_PATH}${CMAKE_ENV_PKG_CONFIG_PATH_SEPARATOR}$ENV{PKG_CONFIG_PATH}")
  else()
    set(ENV{PKG_CONFIG_PATH} "${Streamer_GSTREAMER_PKG_CONFIG_PATH}:$ENV{PKG_CONFIG_PATH}")
  endif()
endif()

# Find dependencies
find_dependency(spdlog REQUIRED)
find_package(GStreamer 1.0 REQUIRED COMPONENTS gstapp gstvideo gstaudio gstrtsp)
find_dependency(OpenCV REQUIRED)
if(TARGET OpenCV::opencv AND NOT TARGET opencv::opencv)
  add_library(opencv::opencv ALIAS OpenCV::opencv)
endif()

# FindGStreamer creates GStreamer::GStreamer and GStreamer::gstapp etc.; our export expects GStreamer::gstreamer-all
if(NOT TARGET GStreamer::gstreamer-all)
  add_library(GStreamer::gstreamer-all INTERFACE IMPORTED)
  target_link_libraries(GStreamer::gstreamer-all INTERFACE GStreamer::GStreamer)
  foreach(_c gstapp gstvideo gstaudio gstrtsp)
    if(TARGET GStreamer::${_c})
      target_link_libraries(GStreamer::gstreamer-all INTERFACE GStreamer::${_c})
    endif()
  endforeach()
endif()

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/StreamerTargets.cmake")

# Check that all required components are available
check_required_components(Streamer)

